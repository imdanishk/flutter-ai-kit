# Starting point for android/fastlane/Fastfile. Ruby syntax checked only (the version helpers in
# versioning.rb are tested); the lanes have not been run against a real project.
# Copy versioning.rb into android/fastlane next to this file. Run from android/:
#   FLUTTER_FLAVOR=staging bundle exec fastlane firebase release:patch release_notes:"Fix login"
require "shellwords"
require File.join(FastlaneCore::FastlaneFolder.path, "versioning.rb")

default_platform(:android)

# Project root is two levels above android/fastlane.
def project_root
  File.expand_path("../..", FastlaneCore::FastlaneFolder.path)
end

def flavor
  ENV["FLUTTER_FLAVOR"] || UI.user_error!("Set FLUTTER_FLAVOR, for example: FLUTTER_FLAVOR=staging bundle exec fastlane firebase")
end

# FLUTTER_CMD overrides. Locally, `fvm flutter` when .fvmrc exists. On CI (the CI variable is set) plain
# `flutter`, because the workflow installs the pinned version itself and FVM is not on the runner.
def flutter_cmd
  return ENV["FLUTTER_CMD"] if ENV["FLUTTER_CMD"]
  return "flutter" if ENV["CI"]
  File.exist?(File.join(project_root, ".fvmrc")) ? "fvm flutter" : "flutter"
end

# Version name and build number for this upload. An explicit build_number: wins.
# Otherwise: the store's latest values (never below the pubspec build), bumped by release: (patch,
# minor, major) or build number only.
def resolve_version(latest_name, latest_build, options)
  pubspec_name, pubspec_build = KitVersioning.pubspec_version(File.read(File.join(project_root, "pubspec.yaml")))
  return [options[:build_name] || pubspec_name, options[:build_number].to_i] if options[:build_number]

  name, build = KitVersioning.base_version(latest_name, latest_build, pubspec_name, pubspec_build)
  KitVersioning.next_version(name, build, options[:release])
end

def flutter_build(kind, name, number)
  args = ["build", kind, "--release", "--flavor", flavor, "--build-name", name, "--build-number", number.to_s]
  args += ["--target", ENV["FLUTTER_TARGET"]] if ENV["FLUTTER_TARGET"]
  sh("cd #{Shellwords.escape(project_root)} && #{flutter_cmd} #{args.join(' ')}")
end

def firebase_latest
  # The action returns the latest release (a hash) or nil when there is none (check the plugin's README).
  release = firebase_app_distribution_get_latest_release(
    app: ENV.fetch("FIREBASE_APP_ID"),
    service_credentials_file: ENV["FIREBASE_DISTRIBUTION_CREDENTIALS"]
  )
  release ? [release[:displayVersion], release[:buildVersion].to_i] : [nil, nil]
rescue NoMethodError => e
  UI.user_error!("The firebase_app_distribution plugin looks missing. Run `bundle exec fastlane add_plugin firebase_app_distribution` in this folder, then retry (#{e.message})")
rescue StandardError => e
  UI.important("Could not read the latest Firebase release (#{e.message}); using the pubspec version.")
  [nil, nil]
end

# Highest version code across all tracks (a new upload must beat every track), and the
# version name of the track being released to.
def play_latest(track)
  common = { package_name: ENV.fetch("PACKAGE_NAME"), json_key: ENV["GOOGLE_PLAY_JSON_KEY_FILE"] }
  errors = []
  codes = %w[internal alpha beta production].flat_map do |t|
    begin
      google_play_track_version_codes(track: t, **common)
    rescue StandardError => e
      errors << e.message # an empty track and a missing permission both land here
      []
    end
  end
  if codes.empty? && errors.size == 4
    UI.important("Could not read any Play track (#{errors.first}). Falling back to the pubspec build number. " \
                 "If the app already has uploads, pass build_number: higher than the highest version code.")
  end
  names = begin
    google_play_track_release_names(track: track, **common)
  rescue StandardError
    []
  end
  name, = KitVersioning.parse_release_name(names.last)
  [name, KitVersioning.highest(codes)]
end

platform :android do
  before_all do
    # One env file per flavor in this folder (.env.staging). It is never committed.
    Dotenv.load(File.join(FastlaneCore::FastlaneFolder.path, ".env.#{flavor}"))
  end

  desc "Build an APK for FLUTTER_FLAVOR and upload it to Firebase App Distribution"
  lane :firebase do |options|
    name, number = resolve_version(*firebase_latest, options)
    flutter_build("apk", name, number)
    firebase_app_distribution(
      app: ENV.fetch("FIREBASE_APP_ID"),
      groups: ENV["FIREBASE_TESTERS_GROUPS"],
      release_notes: options[:release_notes] || "",
      android_artifact_type: "APK",
      # Check the path printed by `flutter build apk`; flavor builds are named app-<flavor>-release.apk.
      android_artifact_path: File.join(project_root, "build", "app", "outputs", "flutter-apk", "app-#{flavor}-release.apk"),
      service_credentials_file: ENV["FIREBASE_DISTRIBUTION_CREDENTIALS"]
    )
    UI.success("Firebase: #{flavor} #{name}+#{number}")
  end

  desc "Build an App Bundle and upload it to a Play track (internal, alpha, beta, production)"
  lane :playstore do |options|
    track = options[:track] || "internal"
    # A closed-test track with a custom name is not listed here: add its name to this list and to play_latest.
    UI.user_error!("Unknown track #{track}") unless %w[internal alpha beta production].include?(track)
    name, number = resolve_version(*play_latest(track), options)
    flutter_build("appbundle", name, number)
    upload_to_play_store(
      track: track,
      package_name: ENV.fetch("PACKAGE_NAME"),
      json_key: ENV["GOOGLE_PLAY_JSON_KEY_FILE"],
      # Check the path printed by `flutter build appbundle`.
      aab: File.join(project_root, "build", "app", "outputs", "bundle", "#{flavor}Release", "app-#{flavor}-release.aab"),
      # Fastlane's default is "completed", which rolls the release out to everyone on that track at once.
      # Only the internal track defaults to that. Alpha, beta and production stay drafts until a person
      # publishes them in Play Console; pass release_status:completed to publish from the lane.
      release_status: options[:release_status] || (track == "internal" ? "completed" : "draft"),
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
    UI.success("Play #{track}: #{flavor} #{name}+#{number}")
  end
end
