# Copy to .env.<flavor> (for example .env.staging) inside android/fastlane and ios/fastlane.
# FLUTTER_FLAVOR itself must be set on the command line (the lane needs it to find this file).
# Keep the real file out of git. Values below are placeholders.
# FLUTTER_TARGET=lib/main_staging.dart

# Android
FIREBASE_APP_ID=
FIREBASE_TESTERS_GROUPS=
FIREBASE_DISTRIBUTION_CREDENTIALS=
PACKAGE_NAME=
GOOGLE_PLAY_JSON_KEY_FILE=

# iOS
APP_IDENTIFIER=
# Optional: several bundle IDs (comma-separated) for certs_get and certs_create across flavors.
# MATCH_APP_IDENTIFIERS=
BUILD_SCHEME=
BUILD_CONFIGURATION=
APPSTORE_TEAM_ID=
ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_KEY_CONTENT=
CERTIFICATE_GIT_URL=
CERTIFICATE_GIT_BRANCH=main
MATCH_PASSWORD=
