# Starting point for ios/fastlane/Fastfile. Checked for Ruby syntax only;
# not run against a real project. Needs macOS, Xcode 26 or later, an App Store Connect API key
# and match storage. Scheme and configuration names come from your Xcode flavor setup.
require "shellwords"

default_platform(:ios)

# Project root is two levels above ios/fastlane.
def project_root
  File.expand_path("../..", FastlaneCore::FastlaneFolder.path)
end

def flavor
  ENV["FLUTTER_FLAVOR"] || UI.user_error!("Set FLUTTER_FLAVOR, for example: FLUTTER_FLAVOR=staging bundle exec fastlane testflight")
end

def flutter_cmd
  File.exist?(File.join(project_root, ".fvmrc")) ? "fvm flutter" : "flutter"
end

def asc_api_key
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_content: ENV.fetch("ASC_KEY_CONTENT"),
    is_key_content_base64: true
  )
end

# Resolve Flutter configuration, sign with a match profile, and build the IPA with gym.
def build_ipa(match_type, export_method, options)
  api_key = asc_api_key
  bundle_id = ENV.fetch("APP_IDENTIFIER")

  args = ["build", "ios", "--release", "--flavor", flavor, "--no-codesign", "--config-only"]
  args += ["--target", ENV["FLUTTER_TARGET"]] if ENV["FLUTTER_TARGET"]
  args += ["--build-name", options[:build_name].to_s] if options[:build_name]
  args += ["--build-number", options[:build_number].to_s] if options[:build_number]
  sh("cd #{Shellwords.escape(project_root)} && #{flutter_cmd} #{args.join(' ')}")

  match(
    type: match_type,
    app_identifier: bundle_id,
    api_key: api_key,
    git_url: ENV["CERTIFICATE_GIT_URL"],
    git_branch: ENV["CERTIFICATE_GIT_BRANCH"] || "main",
    readonly: is_ci
  )

  update_code_signing_settings(
    use_automatic_signing: false,
    path: File.join(project_root, "ios", "Runner.xcodeproj"),
    team_id: ENV.fetch("APPSTORE_TEAM_ID"),
    profile_name: ENV["sigh_#{bundle_id}_#{match_type}_profile-name"],
    code_sign_identity: "Apple Distribution",
    targets: ["Runner"]
  )

  gym(
    workspace: File.join(project_root, "ios", "Runner.xcworkspace"),
    scheme: ENV.fetch("BUILD_SCHEME"),
    configuration: ENV["BUILD_CONFIGURATION"] || "Release",
    export_method: export_method,
    output_directory: File.join(project_root, "build", "ios", "ipa"),
    export_options: { provisioningProfiles: { bundle_id => ENV["sigh_#{bundle_id}_#{match_type}_profile-name"] } }
  )
end

platform :ios do
  desc "Build an ad hoc IPA and upload it to Firebase App Distribution (tester devices must be registered)"
  lane :firebase do |options|
    build_ipa("adhoc", "ad-hoc", options)
    firebase_app_distribution(
      app: ENV.fetch("FIREBASE_APP_ID"),
      groups: ENV["FIREBASE_TESTERS_GROUPS"],
      release_notes: options[:release_notes] || "",
      ipa_path: lane_context[SharedValues::IPA_OUTPUT_PATH],
      service_credentials_file: ENV["FIREBASE_DISTRIBUTION_CREDENTIALS"]
    )
  end

  desc "Build an App Store IPA and upload it to TestFlight (does not submit for App Review)"
  lane :testflight do |options|
    build_ipa("appstore", "app-store", options)
    upload_to_testflight(
      api_key: asc_api_key,
      ipa: lane_context[SharedValues::IPA_OUTPUT_PATH],
      changelog: options[:changelog],
      skip_waiting_for_build_processing: true
    )
  end
end
