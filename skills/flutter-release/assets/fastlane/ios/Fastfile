# Starting point for ios/fastlane/Fastfile. Ruby syntax checked only (the version helpers in
# versioning.rb are tested); the lanes have not been run against a real project.
# Needs macOS, Xcode 26 or later, an App Store Connect API key and match storage (see Matchfile).
# Copy versioning.rb and Matchfile into ios/fastlane. Run from ios/:
#   FLUTTER_FLAVOR=staging bundle exec fastlane testflight release:patch changelog:"What to test"
require "shellwords"
require File.join(FastlaneCore::FastlaneFolder.path, "versioning.rb")

default_platform(:ios)

# Project root is two levels above ios/fastlane.
def project_root
  File.expand_path("../..", FastlaneCore::FastlaneFolder.path)
end

def flavor
  ENV["FLUTTER_FLAVOR"] || UI.user_error!("Set FLUTTER_FLAVOR, for example: FLUTTER_FLAVOR=staging bundle exec fastlane testflight")
end

# FLUTTER_CMD overrides. Locally, `fvm flutter` when .fvmrc exists. On CI (the CI variable is set) plain
# `flutter`, because the workflow installs the pinned version itself and FVM is not on the runner.
def flutter_cmd
  return ENV["FLUTTER_CMD"] if ENV["FLUTTER_CMD"]
  return "flutter" if ENV["CI"]
  File.exist?(File.join(project_root, ".fvmrc")) ? "fvm flutter" : "flutter"
end

def asc_api_key
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_content: ENV.fetch("ASC_KEY_CONTENT"),
    is_key_content_base64: true
  )
end

# See the Android Fastfile: an explicit build_number: wins; otherwise bump the latest store values.
def resolve_version(latest_name, latest_build, options)
  pubspec_name, pubspec_build = KitVersioning.pubspec_version(File.read(File.join(project_root, "pubspec.yaml")))
  return [options[:build_name] || pubspec_name, options[:build_number].to_i] if options[:build_number]

  name, build = KitVersioning.base_version(latest_name, latest_build, pubspec_name, pubspec_build)
  KitVersioning.next_version(name, build, options[:release])
end

def firebase_latest
  # The action returns the latest release (a hash) or nil when there is none (check the plugin's README).
  release = firebase_app_distribution_get_latest_release(
    app: ENV.fetch("FIREBASE_APP_ID"),
    service_credentials_file: ENV["FIREBASE_DISTRIBUTION_CREDENTIALS"]
  )
  release ? [release[:displayVersion], release[:buildVersion].to_i] : [nil, nil]
rescue NoMethodError => e
  UI.user_error!("The firebase_app_distribution plugin looks missing. Run `bundle exec fastlane add_plugin firebase_app_distribution` in this folder, then retry (#{e.message})")
rescue StandardError => e
  UI.important("Could not read the latest Firebase release (#{e.message}); using the pubspec version.")
  [nil, nil]
end

def testflight_latest
  number = latest_testflight_build_number(api_key: asc_api_key, app_identifier: ENV.fetch("APP_IDENTIFIER"))
  name = lane_context[SharedValues::LATEST_TESTFLIGHT_VERSION]
  name && number ? [name.to_s, number.to_i] : [nil, nil]
rescue StandardError => e
  UI.important("Could not read the latest TestFlight build (#{e.message}); using the pubspec version.")
  [nil, nil]
end

# Resolve Flutter configuration, sign with a match profile, and build the IPA with gym.
def build_ipa(match_type, export_method, name, number)
  bundle_id = ENV.fetch("APP_IDENTIFIER")
  args = ["build", "ios", "--release", "--flavor", flavor, "--no-codesign", "--config-only",
          "--build-name", name, "--build-number", number.to_s]
  args += ["--target", ENV["FLUTTER_TARGET"]] if ENV["FLUTTER_TARGET"]
  sh("cd #{Shellwords.escape(project_root)} && #{flutter_cmd} #{args.join(' ')}")

  # On CI, use a temporary keychain so match can import certificates without a prompt (Fastlane's CI
  # guidance; a no-op elsewhere).
  setup_ci if ENV["CI"]

  # CI and everyone without write access to the certificate storage fetch only (readonly).
  match(type: match_type, api_key: asc_api_key, readonly: true)

  profile = ENV["sigh_#{bundle_id}_#{match_type}_profile-name"]
  configuration = ENV["BUILD_CONFIGURATION"] || "Release-#{flavor}"
  pbxproj = File.join(project_root, "ios", "Runner.xcodeproj", "project.pbxproj")
  original_pbxproj = File.read(pbxproj)
  begin
    # This edits ios/Runner.xcodeproj/project.pbxproj (manual signing for one configuration). The original is
    # put back in the ensure below, so the working tree is clean after the run. build_configurations is a
    # parameter of the action (confirmed in Fastlane's source on 2026-11-05).
    update_code_signing_settings(
      use_automatic_signing: false,
      path: File.join(project_root, "ios", "Runner.xcodeproj"),
      team_id: ENV.fetch("APPSTORE_TEAM_ID"),
      profile_name: profile,
      code_sign_identity: "Apple Distribution",
      targets: ["Runner"],
      build_configurations: [configuration]
    )

    gym(
      workspace: File.join(project_root, "ios", "Runner.xcworkspace"),
      scheme: ENV.fetch("BUILD_SCHEME"),
      configuration: configuration,
      # gym's option text lists app-store and ad-hoc as valid (Fastlane source, read 2026-11-05); Xcode's
      # newer names (app-store-connect, release-testing) are not in that list.
      export_method: export_method,
      output_directory: File.join(project_root, "build", "ios", "ipa"),
      export_options: { provisioningProfiles: { bundle_id => profile } }
    )
  ensure
    File.write(pbxproj, original_pbxproj)
  end
end

platform :ios do
  before_all do
    # One env file per flavor in this folder (.env.staging). It is never committed.
    Dotenv.load(File.join(FastlaneCore::FastlaneFolder.path, ".env.#{flavor}"))
  end

  desc "Build an ad hoc IPA and upload it to Firebase App Distribution (tester devices must be registered)"
  lane :firebase do |options|
    name, number = resolve_version(*firebase_latest, options)
    build_ipa("adhoc", "ad-hoc", name, number)
    firebase_app_distribution(
      app: ENV.fetch("FIREBASE_APP_ID"),
      groups: ENV["FIREBASE_TESTERS_GROUPS"],
      release_notes: options[:release_notes] || "",
      ipa_path: lane_context[SharedValues::IPA_OUTPUT_PATH],
      service_credentials_file: ENV["FIREBASE_DISTRIBUTION_CREDENTIALS"]
    )
    UI.success("Firebase: #{flavor} #{name}+#{number}")
  end

  desc "Build an App Store IPA and upload it to TestFlight (does not submit for App Review)"
  lane :testflight do |options|
    name, number = resolve_version(*testflight_latest, options)
    build_ipa("appstore", "app-store", name, number)
    upload_to_testflight(
      api_key: asc_api_key,
      ipa: lane_context[SharedValues::IPA_OUTPUT_PATH],
      changelog: options[:changelog],
      skip_waiting_for_build_processing: true
    )
    UI.success("TestFlight: #{flavor} #{name}+#{number}")
  end

  desc "Fetch the signing certificates and profiles for this flavor (read-only). Run once on a new machine."
  lane :certs_get do
    %w[development adhoc appstore].each { |type| match(type: type, api_key: asc_api_key, readonly: true) }
  end

  desc "Create or renew certificates and profiles (writes to the certificate storage). Needs an Account Holder or Admin."
  lane :certs_create do |options|
    UI.user_error!("This writes to the shared certificate storage. Re-run with confirm:yes after the account holder agrees.") unless options[:confirm] == "yes"
    %w[development adhoc appstore].each { |type| match(type: type, api_key: asc_api_key, readonly: false) }
  end

  desc "Register a tester device (name:, udid:, confirm:yes), then refresh the ad hoc profile. Writes to the Apple account and the certificate storage."
  lane :add_device do |options|
    UI.user_error!("Pass name: and udid:") unless options[:name] && options[:udid]
    UI.user_error!("This registers a device in the Apple account and pushes a new profile to the certificate storage. Re-run with confirm:yes after the account holder agrees.") unless options[:confirm] == "yes"
    register_device(name: options[:name], udid: options[:udid], api_key: asc_api_key)
    match(type: "adhoc", api_key: asc_api_key, force_for_new_devices: true)
  end
end
